# Скопируй в vars.env и заполни своими значениями
# vars.env добавлен в .gitignore — не коммить его
#
# Variant C2: All-in-One, 17 протоколов на :443
# Архитектура: VLESS+Vision+TLS главный inbound → fallbacks → sub-inbounds + Nginx
# Reality НЕДОСТУПНА (несовместима с fallbacks)
# Нужен: домен + wildcard TLS-сертификат (*.DOMAIN + DOMAIN)

# --- Секреты (make keys VAR=variant-c2) ---
UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx    # VLESS + VMess
TR_PASSWORD=your-trojan-password              # Trojan
SS_PASSWORD=your-ss-password-base64           # SS 2022 (16 байт, base64)
SS_METHOD=2022-blake3-aes-128-gcm

# --- Домен и IP ---
DOMAIN=your-domain.com
SERVER_IP=1.2.3.4

# --- TLS сертификат ---
# Нужен wildcard или SAN: DOMAIN + *.DOMAIN (покрывает H2-субдомены)
# certbot certonly --standalone -d your-domain.com -d *.your-domain.com
CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- Пути WebSocket + TCP obfs ---
VLESS_WS_PATH=/vlws
VMESS_WS_PATH=/vmws
TROJAN_WS_PATH=/trojanws
SS_WS_PATH=/ssws
VLESS_TC_PATH=/vltc
VMESS_TC_PATH=/vmtc
SS_TC_PATH=/sstc

# --- gRPC service names ---
TROJAN_GRPC_SVC=trgrpc
VLESS_GRPC_SVC=vlgrpc
VMESS_GRPC_SVC=vmgrpc
SS_GRPC_SVC=ssgrpc

# --- H2 субдомены (DNS A-записи → SERVER_IP обязательны) ---
TROJAN_H2_SNI=trh2o.your-domain.com
VLESS_H2_SNI=vlh2o.your-domain.com
VMESS_H2_SNI=vmh2o.your-domain.com
SS_H2_SNI=ssh2o.your-domain.com

# --- Внутренние порты sub-inbounds ---
TROJAN_GRPC_PORT=3001
VLESS_GRPC_PORT=3002
VMESS_GRPC_PORT=3003
SS_GRPC_PORT=3004
SS_WS_PORT=4001
SS_TC_PORT=4002
SS_H2_PORT=4003

# --- Unix sockets (Nginx) ---
H1_SOCK=/dev/shm/xraylab-c2-h1.sock
H2C_SOCK=/dev/shm/xraylab-c2-h2c.sock

# --- API ---
API_PORT=62789

# --- Subscription ---
SUB_PATH=/sub

# --- Клиент ---
SOCKS_PORT=1080
HTTP_PORT=8118

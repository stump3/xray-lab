# Скопируй в vars.env и заполни своими значениями
# vars.env добавлен в .gitignore — не коммить его

# --- Reality ключи (make keys) ---
UUID_REALITY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UUID_WS=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
PRIV_KEY=your-private-key-base64
PUB_KEY=your-public-key-base64
SHORT_ID=aabbccdd11223344

# --- Домены ---
DOMAIN=your-domain.com            # собственный домен с TLS-сертификатом
REALITY_DOMAIN=www.microsoft.com  # decoy: без Cloudflare, TLS 1.3 + HTTP/2

# --- IP сервера ---
SERVER_IP=1.2.3.4

# --- Внутренние порты (Nginx stream → Xray, выбираются произвольно) ---
REALITY_INBOUND_PORT=8443         # Reality inbound слушает здесь
WS_INBOUND_PORT=9001              # WS inbound слушает здесь
NGINX_HTTPS_PORT=7443             # Nginx HTTPS server слушает здесь

# --- WS путь ---
WS_PATH=/your-ws-path

# --- TLS сертификат (для Nginx HTTPS + WS) ---
# Получить: certbot certonly --standalone -d your-domain.com
CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- Subscription endpoint ---
SUB_PATH=/sub

# --- Клиент (локальный SOCKS5/HTTP прокси от xray-client) ---
SOCKS_PORT=1080
HTTP_PORT=8118

# Скопируй в vars.env и заполни своими значениями
# vars.env добавлен в .gitignore — не коммить его
#
# Variant C: Xray занимает :443 с VLESS+TLS, fallbacks → sub-inbounds → Nginx
# Reality НЕДОСТУПНА в этой схеме (несовместимо с fallbacks)

# --- UUID (make keys VAR=variant-c) ---
UUID_VLESS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UUID_VMESS=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# --- Домен и IP ---
DOMAIN=your-domain.com            # обязателен — нужен TLS сертификат
SERVER_IP=1.2.3.4

# --- TLS сертификат (Xray терминирует TLS напрямую) ---
# Получить: certbot certonly --standalone -d your-domain.com
CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- Пути для протоколов (fallback маршрутизирует по path) ---
VLESS_WS_PATH=/vless-ws
VMESS_WS_PATH=/vmess-ws

# --- Внутренние порты sub-inbounds ---
VLESS_WS_PORT=9001
VMESS_WS_PORT=9002

# --- Nginx: unix-сокеты (decoy сайт + gRPC) ---
# Nginx слушает на unix socket, без TCP-порта
H1_SOCK=/dev/shm/xraylab-c-h1.sock

# --- Subscription ---
SUB_PATH=/sub

# --- Клиент ---
SOCKS_PORT=1080
HTTP_PORT=8118

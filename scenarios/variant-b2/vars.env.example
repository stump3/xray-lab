# Скопируй в vars.env и заполни своими значениями
# vars.env добавлен в .gitignore — не коммить его
#
# Variant B2: Nginx stream SNI routing + Hysteria2
# Reality + WS/CDN на :443 (TCP), Hysteria2 на :443 (UDP)

# --- Ключи (make keys VAR=variant-b2) ---
UUID_REALITY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UUID_WS=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
PRIV_KEY=your-private-key-base64
PUB_KEY=your-public-key-base64
SHORT_ID=aabbccdd11223344
H2_PASSWORD=your-hysteria2-password

# --- Домены ---
DOMAIN=your-domain.com             # собственный домен → Nginx HTTPS + WS
REALITY_DOMAIN=www.microsoft.com   # decoy: без Cloudflare, TLS 1.3 + HTTP/2

# --- Hysteria2 домен и сертификат ---
# Может совпадать с DOMAIN (общий сертификат) или быть отдельным
H2_DOMAIN=your-domain.com
H2_CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
H2_KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- IP сервера ---
SERVER_IP=1.2.3.4

# --- Внутренние порты (Nginx stream → Xray) ---
REALITY_INBOUND_PORT=8443
WS_INBOUND_PORT=9001
NGINX_HTTPS_PORT=7443

# --- WS путь ---
WS_PATH=/your-ws-path

# --- TLS сертификат (для Nginx HTTPS + WS) ---
# Получить: certbot certonly --standalone -d your-domain.com
CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- Subscription ---
SUB_PATH=/sub

# --- Клиент ---
SOCKS_PORT=1080
HTTP_PORT=8118

# Скопируй в vars.env и заполни своими значениями
# vars.env добавлен в .gitignore — не коммить его
#
# Variant D: Self-SNI — Xray :443 с VLESS+TLS, decoy — собственный сайт на том же IP
# Reality НЕДОСТУПНА (несовместимо с fallbacks).
# Ключевое отличие от Reality: домен, сертификат, IP и сайт полностью согласованы.

# --- UUID (make keys VAR=variant-d) ---
UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Домен (обязателен — для сертификата и легенды сервера) ---
DOMAIN=your-domain.com

# --- IP сервера ---
SERVER_IP=1.2.3.4

# --- TLS сертификат (Xray терминирует напрямую) ---
# Получить через certbot:
#   certbot certonly --standalone -d your-domain.com
# Или через acme.sh (ECDSA ec-256 — как в xray-with-selfsni):
#   ~/.acme.sh/acme.sh --issue --server letsencrypt -d your-domain.com \
#       -w /var/www/html --keylength ec-256
CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# --- Nginx: decoy сайт на loopback (Xray fallback пишет сюда) ---
# Снаружи недоступен напрямую — только через Xray fallback и redirect с :80
NGINX_DECOY_PORT=8080       # только 127.0.0.1:8080 — произвольный выбор

# --- Клиент ---
SOCKS_PORT=1080
HTTP_PORT=8118
